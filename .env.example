# InsightCart environment configuration
# Copy this file to .env and adjust values locally. Never commit .env.

# PostgreSQL connection (SQLAlchemy URL with psycopg3 driver)
DATABASE_URL=postgresql+psycopg://insightcart:insightcart@localhost:5432/insightcart

API_HOST=0.0.0.0
API_PORT=8000

ENVIRONMENT=development

# --- Ask Your Data (text-to-SQL) -------------------------------------------
# Separate DB URL is optional (defaults to DATABASE_URL). Demo data lives in schema ask_demo.
# ASK_DATABASE_URL=postgresql+psycopg://insightcart:insightcart@localhost:5433/insightcart
ASK_DB_SCHEMA=ask_demo
# "Today" for relative dates. The demo data is built around 2026-10-13; unset to use the real date.
ASK_AS_OF_DATE=2026-10-13
# offline (default, no network, free) | groq | gemini  (free tiers; keys go in .env, never commit them)
ASK_LLM_PROVIDER=offline
# ASK_LLM_MODEL=
# GROQ_API_KEY=
# GEMINI_API_KEY=
